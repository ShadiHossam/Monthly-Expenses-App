:80 {
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'none';"
    }

    handle /api/* {
        reverse_proxy backend:8080
    }

    handle /health {
        reverse_proxy backend:8080
    }

    handle {
        reverse_proxy frontend:80
    }
}
