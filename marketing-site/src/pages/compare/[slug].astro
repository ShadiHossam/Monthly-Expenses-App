---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";

export function getStaticPaths() {
  const competitors = [
    {
      slug: "empower",
      name: "Empower Personal Dashboard",
      blurb: "A free net-worth and investment tracking dashboard that upsells into paid wealth management — not a UAE-focused budgeting tool.",
    },
    {
      slug: "pocketguard",
      name: "PocketGuard",
      blurb: "A simple US-focused spend-tracking app built around a single 'in my pocket' number, with no UAE bank connectivity.",
    },
    {
      slug: "goodbudget",
      name: "Goodbudget",
      blurb: "A digital envelope-budgeting app in the spirit of classic cash-envelope systems, manually maintained with no bank statement import.",
    },
    {
      slug: "simplifi",
      name: "Simplifi by Quicken",
      blurb: "Quicken's modern budgeting app, built around US bank connections via Plaid, with no direct support for UAE institutions.",
    },
  ];
  return competitors.map(c => ({ params: { slug: c.slug }, props: { competitor: c } }));
}

const { competitor } = Astro.props;

const faqs = [
  { q: `Does ${competitor.name} support UAE banks?`, a: `No. Like most US-built budgeting apps, ${competitor.name} relies on bank-linking providers (such as Plaid) that don't cover UAE institutions like Emirates NBD, ADCB, FAB, or Mashreq — UAE users are limited to manual entry.` },
  { q: `Can I use ${competitor.name} with AED?`, a: `${competitor.name} is built primarily around USD and US financial accounts. It has no native UAE bank statement import, and multi-currency support (if any) is typically limited compared to a UAE-built tool.` },
  { q: `Is FinTrack a good alternative to ${competitor.name} for UAE residents?`, a: `Yes — FinTrack was built specifically for UAE banks, AED, and local merchants like Salik, DEWA, and Talabat, with a free plan and direct PDF statement upload instead of relying on unavailable bank connections.` },
];

const ldJson = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Compare", url: "/compare" },
  { name: `FinTrack vs ${competitor.name}`, url: `/compare/${competitor.slug}` },
];
---

<BaseLayout
  title={`FinTrack vs ${competitor.name} — UAE Comparison`}
  description={`${competitor.name} has no UAE bank support. Compare FinTrack vs ${competitor.name} on bank statement import, AED support, and pricing for UAE residents.`}
  canonicalPath={`/compare/${competitor.slug}`}
  ldJson={ldJson}
  breadcrumbs={breadcrumbs}
>

<div class="page-hero" style="padding-top:9rem;padding-bottom:5rem;">
  <div class="container" style="position:relative;z-index:1;">
    <span class="badge badge-green" style="margin-bottom:1.25rem;background:rgba(16,185,129,0.15);color:var(--green-400);border-color:rgba(16,185,129,0.25);">Comparison</span>
    <h1 style="color:#ffffff;margin-bottom:1rem;">FinTrack vs {competitor.name}.</h1>
    <p style="color:rgba(255,255,255,0.55);font-size:1.0625rem;max-width:600px;margin:0 auto;">{competitor.blurb}</p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="compare-wrap overflow-x-auto" style="max-width:900px;margin:0 auto;">
      <table class="compare-table">
        <thead>
          <tr>
            <th style="text-align:left;min-width:220px;">Feature</th>
            <th style="text-align:center;color:var(--green-700);">FinTrack</th>
            <th style="text-align:center;color:var(--text-muted);">{competitor.name}</th>
          </tr>
        </thead>
        <tbody>
          <tr><td style="font-weight:600;">UAE bank statement OCR</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">Works natively in AED</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">Safe-to-Spend daily number</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">AI conversational analytics</td><td class="check-yes">✓</td><td class="check-partial">Varies</td></tr>
          <tr><td style="font-weight:600;">Free plan available</td><td class="check-yes">✓</td><td class="check-partial">Varies by plan</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section" style="background:var(--green-50);">
  <div class="container" style="max-width:820px;">
    <div class="section-header">
      <span class="section-eyebrow">Why UAE Users Choose FinTrack</span>
      <h2>Built for UAE Banks From Day One.</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <h3 style="margin-bottom:.5rem;">No bank-link gap</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">{competitor.name}'s automatic bank sync doesn't reach UAE institutions. FinTrack's statement-upload model was purpose-built to close that gap.</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom:.5rem;">UAE merchant intelligence</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">FinTrack's AI recognizes Carrefour, Noon, Talabat, and DEWA out of the box — categories a US-focused app would file as "miscellaneous."</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom:.5rem;">A genuine free tier</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">FinTrack's Free plan covers basic tracking and the Safe-to-Spend dashboard indefinitely, so you can try it properly before upgrading.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:720px;">
    <div class="section-header">
      <span class="section-eyebrow">FAQ</span>
      <h2>FinTrack vs {competitor.name} — Common Questions</h2>
    </div>
    <div style="border-top:1px solid var(--border);">
      {faqs.map(item => (
        <div class="faq-item">
          <button class="faq-btn">
            {item.q}
            <span class="faq-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--green-700)" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-body">{item.a}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-sm" style="background:var(--green-50);padding-bottom:5rem;">
  <div class="container">
    <div class="cta-band" style="max-width:760px;margin:0 auto;">
      <div style="position:relative;z-index:1;">
        <h2 style="color:#ffffff;font-size:clamp(1.75rem,3.5vw,2.5rem);margin-bottom:1rem;">Try the UAE-Built Alternative.</h2>
        <p style="color:rgba(255,255,255,0.55);margin-bottom:2rem;max-width:420px;margin-left:auto;margin-right:auto;">
          Free to start, no credit card, and it reads your UAE bank statement in seconds.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
          <a href={SITE.appUrl + '/register'} class="btn-primary" style="background:var(--green-500);color:var(--green-950);">Start Free</a>
          <a href="/compare" class="btn-outline" style="border-color:rgba(255,255,255,0.25);color:rgba(255,255,255,0.75);background:transparent;">See All Comparisons</a>
        </div>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
