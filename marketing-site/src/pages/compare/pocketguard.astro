---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";

const faqs = [
  { q: "Does PocketGuard's 'In My Pocket' number work the same as FinTrack's Safe-to-Spend?", a: "They're built on a similar idea — a single spendable number after bills and goals — but PocketGuard calculates it from linked US bank accounts via Plaid, which doesn't support Emirates NBD, ADCB, or FAB. FinTrack calculates the same kind of number from a UAE bank statement you upload directly." },
  { q: "How much does PocketGuard cost compared to FinTrack?", a: "PocketGuard's free tier is limited to basic tracking; PocketGuard Plus runs about $7.99/month or a one-time lifetime fee, billed in USD. FinTrack's Free plan has no time limit, and Premium is a flat AED 36/month (~$9.80) with no lifetime-only lock-in." },
  { q: "Does PocketGuard have bill negotiation like it advertises?", a: "Yes — PocketGuard Plus includes a bill-lowering service that negotiates certain US recurring bills on your behalf, which isn't relevant for UAE utility or telecom providers like DEWA or Etisalat. FinTrack instead focuses on flagging UAE recurring bills automatically inside your Safe-to-Spend calculation." },
];

const ldJson = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Compare", url: "/compare" },
  { name: "FinTrack vs PocketGuard", url: "/compare/pocketguard" },
];
---

<BaseLayout
  title="FinTrack vs PocketGuard — UAE Comparison"
  description="PocketGuard's 'In My Pocket' number relies on US bank linking that doesn't cover UAE banks. Compare FinTrack vs PocketGuard on statement import, AED, and pricing."
  canonicalPath="/compare/pocketguard"
  ldJson={ldJson}
  breadcrumbs={breadcrumbs}
>

<div class="page-hero" style="padding-top:9rem;padding-bottom:5rem;">
  <div class="container" style="position:relative;z-index:1;">
    <span class="badge badge-green" style="margin-bottom:1.25rem;background:rgba(16,185,129,0.15);color:var(--green-400);border-color:rgba(16,185,129,0.25);">Comparison</span>
    <h1 style="color:#ffffff;margin-bottom:1rem;">FinTrack vs PocketGuard.</h1>
    <p style="color:rgba(255,255,255,0.55);font-size:1.0625rem;max-width:600px;margin:0 auto;">
      PocketGuard popularized the "one number you can safely spend" idea for US bank accounts. It has no way to read a UAE PDF statement. Here's how the two actually compare.
    </p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="compare-wrap overflow-x-auto" style="max-width:900px;margin:0 auto;">
      <table class="compare-table">
        <thead>
          <tr>
            <th style="text-align:left;min-width:220px;">Feature</th>
            <th style="text-align:center;color:var(--green-700);">FinTrack</th>
            <th style="text-align:center;color:var(--text-muted);">PocketGuard</th>
          </tr>
        </thead>
        <tbody>
          <tr><td style="font-weight:600;">UAE bank statement OCR</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">Works natively in AED</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">"Safe to spend" style daily number</td><td class="check-yes">✓</td><td class="check-yes">✓ (US accounts only)</td></tr>
          <tr><td style="font-weight:600;">US bill-negotiation service</td><td class="check-no">✗</td><td class="check-yes">✓</td></tr>
          <tr><td style="font-weight:600;">AI conversational analytics</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">Free plan available</td><td class="check-yes">✓</td><td class="check-partial">Limited features</td></tr>
          <tr><td style="font-weight:600;">Starting price</td><td style="text-align:center;color:var(--green-700);font-weight:700;">Free</td><td style="text-align:center;color:var(--text-muted);font-weight:600;">~$7.99/mo</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section" style="background:var(--green-50);">
  <div class="container" style="max-width:820px;">
    <div class="section-header">
      <span class="section-eyebrow">Why UAE Users Choose FinTrack</span>
      <h2>The Same Idea, Actually Usable Here.</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <h3 style="margin-bottom:.5rem;">No Plaid, no problem</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">PocketGuard's number is only as accurate as its bank sync, which stops at US institutions. FinTrack reads the statement your UAE bank already gives you.</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom:.5rem;">UAE merchant intelligence</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">FinTrack recognizes Carrefour, Noon, Talabat, Salik, and DEWA out of the box — a US-focused engine would flag most of these as unrecognized.</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom:.5rem;">No lifetime-fee lock-in</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">PocketGuard's full feature set sits behind Plus or a one-time lifetime purchase. FinTrack's Free plan covers the core Safe-to-Spend experience indefinitely.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:720px;">
    <div class="section-header">
      <span class="section-eyebrow">FAQ</span>
      <h2>FinTrack vs PocketGuard — Common Questions</h2>
    </div>
    <div style="border-top:1px solid var(--border);">
      {faqs.map(item => (
        <div class="faq-item">
          <button class="faq-btn">
            {item.q}
            <span class="faq-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--green-700)" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-body">{item.a}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-sm" style="background:var(--green-50);padding-bottom:5rem;">
  <div class="container">
    <div class="cta-band" style="max-width:760px;margin:0 auto;">
      <div style="position:relative;z-index:1;">
        <h2 style="color:#ffffff;font-size:clamp(1.75rem,3.5vw,2.5rem);margin-bottom:1rem;">Know Your Number, UAE-Style.</h2>
        <p style="color:rgba(255,255,255,0.55);margin-bottom:2rem;max-width:420px;margin-left:auto;margin-right:auto;">
          Free to start, no credit card, and it reads your UAE bank statement in seconds.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
          <a href={SITE.appUrl + '/register'} class="btn-primary" style="background:var(--green-500);color:var(--green-950);">Start Free</a>
          <a href="/compare" class="btn-outline" style="border-color:rgba(255,255,255,0.25);color:rgba(255,255,255,0.75);background:transparent;">See All Comparisons</a>
        </div>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
