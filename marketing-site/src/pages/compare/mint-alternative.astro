---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";

const faqs = [
  { q: "Why did Mint shut down?", a: "Intuit (Mint's parent company) discontinued Mint in March 2024, directing users to migrate to Credit Karma — a US-focused credit monitoring product with no dedicated budgeting tools or UAE bank support." },
  { q: "Can I import my Mint data into FinTrack?", a: "Mint allowed data export before shutdown. If you saved a CSV export of your transaction history, you can use it as a reference while FinTrack builds your categorized history fresh from your UAE bank statements going forward." },
  { q: "Did Mint ever support UAE banks?", a: "No. Mint only connected to US and Canadian financial institutions via Plaid. UAE residents and expats using Mint were always limited to manual transaction entry." },
];

const ldJson = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Compare", url: "/compare" },
  { name: "Mint Alternative", url: "/compare/mint-alternative" },
];
---

<BaseLayout
  title="Best Mint Alternative for UAE Residents | FinTrack"
  description="Mint shut down in 2024. See why FinTrack is the best Mint alternative for UAE residents and expats — UAE bank statement OCR, AED support, and a free plan."
  canonicalPath="/compare/mint-alternative"
  ldJson={ldJson}
  breadcrumbs={breadcrumbs}
>

<div class="page-hero" style="padding-top:9rem;padding-bottom:5rem;">
  <div class="container" style="position:relative;z-index:1;">
    <span class="badge badge-amber" style="margin-bottom:1.25rem;">Mint shut down in 2024</span>
    <h1 style="color:#ffffff;margin-bottom:1rem;">Looking for a Mint Alternative?</h1>
    <p style="color:rgba(255,255,255,0.55);font-size:1.0625rem;max-width:600px;margin:0 auto;">
      Intuit shut down Mint in March 2024 and pushed users toward Credit Karma — a US credit product with no real budgeting tools and, like Mint before it, no support for UAE banks. If you're in the UAE or GCC, here's what to use instead.
    </p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="compare-wrap overflow-x-auto" style="max-width:900px;margin:0 auto;">
      <table class="compare-table">
        <thead>
          <tr>
            <th style="text-align:left;min-width:220px;">Feature</th>
            <th style="text-align:center;color:var(--green-700);">FinTrack</th>
            <th style="text-align:center;color:var(--text-muted);">Mint (discontinued)</th>
          </tr>
        </thead>
        <tbody>
          <tr><td style="font-weight:600;">Still operating</td><td class="check-yes">✓</td><td class="check-no">✗ Shut down March 2024</td></tr>
          <tr><td style="font-weight:600;">UAE bank statement OCR</td><td class="check-yes">✓</td><td class="check-no">✗ Never supported</td></tr>
          <tr><td style="font-weight:600;">Works natively in AED</td><td class="check-yes">✓</td><td class="check-no">✗ US/Canada only</td></tr>
          <tr><td style="font-weight:600;">Safe-to-Spend daily number</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">AI conversational analytics</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">Free plan available</td><td class="check-yes">✓</td><td class="check-partial">Was free, now gone</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section" style="background:var(--green-50);">
  <div class="container" style="max-width:820px;">
    <div class="section-header">
      <span class="section-eyebrow">What UAE Mint Users Need</span>
      <h2>Everything Mint Didn't Have — Plus It Still Exists.</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <h3 style="margin-bottom:.5rem;">Actually built for AED</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Mint was a US product through and through. FinTrack was built from day one around UAE bank statements, AED, and local merchants like Salik, DEWA, and Talabat.</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom:.5rem;">No manual re-entry</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Mint required a direct bank connection that never extended to the GCC. FinTrack works from a simple PDF statement upload — no bank login sharing required.</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom:.5rem;">A product that won't disappear</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">FinTrack is an independent, growing UAE fintech company — not a legacy feature inside a larger US tax-software business that can be discontinued overnight.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:720px;">
    <div class="section-header">
      <span class="section-eyebrow">FAQ</span>
      <h2>Mint Shutdown — Common Questions</h2>
    </div>
    <div style="border-top:1px solid var(--border);">
      {faqs.map(item => (
        <div class="faq-item">
          <button class="faq-btn">
            {item.q}
            <span class="faq-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--green-700)" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-body">{item.a}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-sm" style="background:var(--green-50);padding-bottom:5rem;">
  <div class="container">
    <div class="cta-band" style="max-width:760px;margin:0 auto;">
      <div style="position:relative;z-index:1;">
        <h2 style="color:#ffffff;font-size:clamp(1.75rem,3.5vw,2.5rem);margin-bottom:1rem;">Pick Up Where Mint Left Off.</h2>
        <p style="color:rgba(255,255,255,0.55);margin-bottom:2rem;max-width:420px;margin-left:auto;margin-right:auto;">
          Free to start, built for UAE banks, and it's not going anywhere.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
          <a href={SITE.appUrl + '/register'} class="btn-primary" style="background:var(--green-500);color:var(--green-950);">Start Free</a>
          <a href="/compare" class="btn-outline" style="border-color:rgba(255,255,255,0.25);color:rgba(255,255,255,0.75);background:transparent;">See All Comparisons</a>
        </div>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
