---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";

const faqs = [
  { q: "Does Simplifi by Quicken work with UAE banks?", a: "No. Simplifi's bank linking runs on Plaid, which covers US and some Canadian institutions only — Emirates NBD, ADCB, and FAB aren't supported, so UAE users would be stuck on manual entry. FinTrack was built the other way around: upload the PDF statement your UAE bank already gives you." },
  { q: "How does Simplifi's Spending Plan compare to Safe-to-Spend?", a: "Simplifi's Spending Plan forecasts your month against planned income and bills, similar in spirit to FinTrack's Safe-to-Spend number — but it's calculated from linked accounts that can't include a UAE bank, so the forecast would be based on manually entered data instead of real transactions." },
  { q: "Is Simplifi cheaper than FinTrack?", a: "Simplifi has no permanent free tier — only a free trial, after which it's about $47.88/year (~AED 14/month equivalent) billed annually in USD. FinTrack's Free plan never expires, and Premium is AED 36/month with no annual commitment required." },
];

const ldJson = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Compare", url: "/compare" },
  { name: "FinTrack vs Simplifi", url: "/compare/simplifi" },
];
---

<BaseLayout
  title="FinTrack vs Simplifi by Quicken — UAE Comparison"
  description="Simplifi's Plaid-based bank linking doesn't reach UAE banks and has no permanent free plan. Compare FinTrack vs Simplifi on statement import, AED, and pricing."
  canonicalPath="/compare/simplifi"
  ldJson={ldJson}
  breadcrumbs={breadcrumbs}
>

<div class="page-hero" style="padding-top:9rem;padding-bottom:5rem;">
  <div class="container" style="position:relative;z-index:1;">
    <span class="badge badge-green" style="margin-bottom:1.25rem;background:rgba(16,185,129,0.15);color:var(--green-400);border-color:rgba(16,185,129,0.25);">Comparison</span>
    <h1 style="color:#ffffff;margin-bottom:1rem;">FinTrack vs Simplifi.</h1>
    <p style="color:rgba(255,255,255,0.55);font-size:1.0625rem;max-width:600px;margin:0 auto;">
      Simplifi by Quicken is a well-built spending-plan app for US bank accounts, sold on an annual subscription with no lasting free tier. Here's how it compares for UAE residents.
    </p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="compare-wrap overflow-x-auto" style="max-width:900px;margin:0 auto;">
      <table class="compare-table">
        <thead>
          <tr>
            <th style="text-align:left;min-width:220px;">Feature</th>
            <th style="text-align:center;color:var(--green-700);">FinTrack</th>
            <th style="text-align:center;color:var(--text-muted);">Simplifi</th>
          </tr>
        </thead>
        <tbody>
          <tr><td style="font-weight:600;">UAE bank statement OCR</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">Works natively in AED</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">Spending forecast (Spending Plan / Safe-to-Spend)</td><td class="check-yes">✓</td><td class="check-yes">✓ (US accounts only)</td></tr>
          <tr><td style="font-weight:600;">Watchlists / custom spending alerts</td><td class="check-partial">Budget alerts</td><td class="check-yes">✓</td></tr>
          <tr><td style="font-weight:600;">Permanent free plan</td><td class="check-yes">✓</td><td class="check-no">✗ Trial only</td></tr>
          <tr><td style="font-weight:600;">Starting price</td><td style="text-align:center;color:var(--green-700);font-weight:700;">Free</td><td style="text-align:center;color:var(--text-muted);font-weight:600;">~$47.88/yr</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section" style="background:var(--green-50);">
  <div class="container" style="max-width:820px;">
    <div class="section-header">
      <span class="section-eyebrow">Why UAE Users Choose FinTrack</span>
      <h2>The Forecast Simplifi Can't Build Here.</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <h3 style="margin-bottom:.5rem;">No bank-link gap</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Simplifi's Spending Plan is only as accurate as the accounts feeding it — and Plaid doesn't reach UAE banks. FinTrack's statement upload closes that gap directly.</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom:.5rem;">No annual commitment</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Simplifi's pricing is built around an annual USD subscription with only a trial period free. FinTrack's Free plan runs indefinitely, and Premium is billed monthly in AED.</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom:.5rem;">UAE merchant intelligence</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">FinTrack recognizes Carrefour, Noon, Talabat, Salik, and DEWA automatically — merchants a US-built categorization engine wouldn't know.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:720px;">
    <div class="section-header">
      <span class="section-eyebrow">FAQ</span>
      <h2>FinTrack vs Simplifi — Common Questions</h2>
    </div>
    <div style="border-top:1px solid var(--border);">
      {faqs.map(item => (
        <div class="faq-item">
          <button class="faq-btn">
            {item.q}
            <span class="faq-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--green-700)" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-body">{item.a}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-sm" style="background:var(--green-50);padding-bottom:5rem;">
  <div class="container">
    <div class="cta-band" style="max-width:760px;margin:0 auto;">
      <div style="position:relative;z-index:1;">
        <h2 style="color:#ffffff;font-size:clamp(1.75rem,3.5vw,2.5rem);margin-bottom:1rem;">A Spending Plan Built for UAE Banks.</h2>
        <p style="color:rgba(255,255,255,0.55);margin-bottom:2rem;max-width:420px;margin-left:auto;margin-right:auto;">
          Free to start, no annual lock-in, and it reads your UAE bank statement in seconds.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
          <a href={SITE.appUrl + '/register'} class="btn-primary" style="background:var(--green-500);color:var(--green-950);">Start Free</a>
          <a href="/compare" class="btn-outline" style="border-color:rgba(255,255,255,0.25);color:rgba(255,255,255,0.75);background:transparent;">See All Comparisons</a>
        </div>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
