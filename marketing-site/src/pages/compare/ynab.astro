---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";

const faqs = [
  { q: "Is FinTrack cheaper than YNAB?", a: "Yes. FinTrack is free forever for basic tracking, and Premium is AED 36/month (~$9.80) versus YNAB's $14.99/month. FinTrack also has no free trial time limit — the Free plan never expires." },
  { q: "Does YNAB work with UAE banks?", a: "No. YNAB has no direct integration with Emirates NBD, ADCB, FAB, Mashreq, or any UAE bank, and no PDF statement import — UAE users must enter transactions manually or export CSVs and manually map columns every month." },
  { q: "Can I import my YNAB budget into FinTrack?", a: "You can export your transaction history from YNAB as a CSV and upload your UAE bank statements directly to FinTrack going forward — most users start fresh with a statement upload since FinTrack's categorization engine is built specifically for UAE merchants." },
];

const ldJson = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Compare", url: "/compare" },
  { name: "FinTrack vs YNAB", url: "/compare/ynab" },
];
---

<BaseLayout
  title="FinTrack vs YNAB — Best YNAB Alternative for UAE"
  description="YNAB doesn't support UAE banks or AED. Compare FinTrack vs YNAB on pricing, bank statement import, and features built for UAE residents and expats."
  canonicalPath="/compare/ynab"
  ldJson={ldJson}
  breadcrumbs={breadcrumbs}
>

<div class="page-hero" style="padding-top:9rem;padding-bottom:5rem;">
  <div class="container" style="position:relative;z-index:1;">
    <span class="badge badge-green" style="margin-bottom:1.25rem;background:rgba(16,185,129,0.15);color:var(--green-400);border-color:rgba(16,185,129,0.25);">Comparison</span>
    <h1 style="color:#ffffff;margin-bottom:1rem;">FinTrack vs YNAB.</h1>
    <p style="color:rgba(255,255,255,0.55);font-size:1.0625rem;max-width:600px;margin:0 auto;">
      YNAB (You Need A Budget) is a well-loved zero-based budgeting tool built for the US market. It's never supported UAE banks, and at $14.99/month it's the most expensive app in this comparison. Here's how FinTrack stacks up for UAE residents and GCC expats.
    </p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="compare-wrap overflow-x-auto" style="max-width:900px;margin:0 auto;">
      <table class="compare-table">
        <thead>
          <tr>
            <th style="text-align:left;min-width:220px;">Feature</th>
            <th style="text-align:center;color:var(--green-700);">FinTrack</th>
            <th style="text-align:center;color:var(--text-muted);">YNAB</th>
          </tr>
        </thead>
        <tbody>
          <tr><td style="font-weight:600;">UAE bank statement OCR (Emirates NBD, ADCB, FAB, Mashreq+)</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">Works natively in AED</td><td class="check-yes">✓</td><td class="check-partial">Manual only</td></tr>
          <tr><td style="font-weight:600;">Safe-to-Spend daily number</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">Zero-based / envelope budgeting</td><td class="check-partial">Optional</td><td class="check-yes">✓</td></tr>
          <tr><td style="font-weight:600;">AI conversational analytics</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">Free plan available</td><td class="check-yes">✓</td><td class="check-no">✗ (34-day trial only)</td></tr>
          <tr><td style="font-weight:600;">Starting price</td><td style="text-align:center;color:var(--green-700);font-weight:700;">Free</td><td style="text-align:center;color:var(--text-muted);font-weight:600;">$14.99/mo</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section" style="background:var(--green-50);">
  <div class="container" style="max-width:820px;">
    <div class="section-header">
      <span class="section-eyebrow">Why UAE users switch</span>
      <h2>YNAB Was Built for a Different Market.</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <h3 style="margin-bottom:.5rem;">No UAE bank connection</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">YNAB relies on Plaid, which doesn't cover UAE banks. Every transaction has to be entered by hand or imported via manual CSV mapping — every single month.</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom:.5rem;">Steeper learning curve</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">YNAB's zero-based method (give every dirham a job) is powerful but has a real learning curve. FinTrack gives you one clear number — Safe-to-Spend — from day one.</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom:.5rem;">No free tier</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">YNAB's trial runs out after 34 days. FinTrack's Free plan has no expiry — track your basics for as long as you like before upgrading.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:720px;">
    <div class="section-header">
      <span class="section-eyebrow">FAQ</span>
      <h2>FinTrack vs YNAB — Common Questions</h2>
    </div>
    <div style="border-top:1px solid var(--border);">
      {faqs.map(item => (
        <div class="faq-item">
          <button class="faq-btn">
            {item.q}
            <span class="faq-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--green-700)" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-body">{item.a}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-sm" style="background:var(--green-50);padding-bottom:5rem;">
  <div class="container">
    <div class="cta-band" style="max-width:760px;margin:0 auto;">
      <div style="position:relative;z-index:1;">
        <h2 style="color:#ffffff;font-size:clamp(1.75rem,3.5vw,2.5rem);margin-bottom:1rem;">Try the UAE-Built Alternative.</h2>
        <p style="color:rgba(255,255,255,0.55);margin-bottom:2rem;max-width:420px;margin-left:auto;margin-right:auto;">
          Free to start, no credit card, and it reads your UAE bank statement in seconds.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
          <a href={SITE.appUrl + '/register'} class="btn-primary" style="background:var(--green-500);color:var(--green-950);">Start Free</a>
          <a href="/compare" class="btn-outline" style="border-color:rgba(255,255,255,0.25);color:rgba(255,255,255,0.75);background:transparent;">See All Comparisons</a>
        </div>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
