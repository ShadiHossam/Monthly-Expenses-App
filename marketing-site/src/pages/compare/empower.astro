---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";

const faqs = [
  { q: "Is Empower Personal Dashboard available in the UAE?", a: "The app itself is accessible worldwide, but its account-linking (via Yodlee) only covers US financial institutions. UAE residents can't connect Emirates NBD, ADCB, or FAB accounts, so the net-worth dashboard stays empty without manual entry." },
  { q: "Why is Empower free if FinTrack also has a free plan?", a: "Empower's dashboard is free because it's a lead-generation tool for their paid wealth management service — expect calls and emails from a financial advisor once your linked balance crosses roughly $100,000. FinTrack's Free plan has no advisory upsell; Premium is a flat AED 36/month with no assets-under-management fee." },
  { q: "Does FinTrack do investment and net-worth tracking like Empower?", a: "Not to the same depth. Empower's Investment Checkup and fee analyzer are genuinely strong tools for a US brokerage portfolio. FinTrack is built around day-to-day spending and your Safe-to-Spend number, not portfolio allocation — if net worth is your primary goal, the two solve different problems." },
];

const ldJson = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Compare", url: "/compare" },
  { name: "FinTrack vs Empower", url: "/compare/empower" },
];
---

<BaseLayout
  title="FinTrack vs Empower — UAE Comparison"
  description="Empower's net-worth dashboard has no UAE bank support and upsells into paid wealth advisory. Compare FinTrack vs Empower on daily spending, AED support, and pricing."
  canonicalPath="/compare/empower"
  ldJson={ldJson}
  breadcrumbs={breadcrumbs}
>

<div class="page-hero" style="padding-top:9rem;padding-bottom:5rem;">
  <div class="container" style="position:relative;z-index:1;">
    <span class="badge badge-green" style="margin-bottom:1.25rem;background:rgba(16,185,129,0.15);color:var(--green-400);border-color:rgba(16,185,129,0.25);">Comparison</span>
    <h1 style="color:#ffffff;margin-bottom:1rem;">FinTrack vs Empower.</h1>
    <p style="color:rgba(255,255,255,0.55);font-size:1.0625rem;max-width:600px;margin:0 auto;">
      Empower Personal Dashboard is a free net-worth and investment tool that funds itself by referring users into paid wealth management. It has no UAE bank connectivity and isn't built for day-to-day spending. Here's how it actually compares for UAE residents.
    </p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="compare-wrap overflow-x-auto" style="max-width:900px;margin:0 auto;">
      <table class="compare-table">
        <thead>
          <tr>
            <th style="text-align:left;min-width:220px;">Feature</th>
            <th style="text-align:center;color:var(--green-700);">FinTrack</th>
            <th style="text-align:center;color:var(--text-muted);">Empower</th>
          </tr>
        </thead>
        <tbody>
          <tr><td style="font-weight:600;">UAE bank statement OCR</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">Works natively in AED</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">Safe-to-Spend daily number</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">Investment & net-worth analysis</td><td class="check-partial">Basic</td><td class="check-yes">✓ Strong</td></tr>
          <tr><td style="font-weight:600;">No advisory upsell / cold calls</td><td class="check-yes">✓</td><td class="check-no">✗</td></tr>
          <tr><td style="font-weight:600;">Free plan available</td><td class="check-yes">✓</td><td class="check-yes">✓</td></tr>
          <tr><td style="font-weight:600;">Starting price</td><td style="text-align:center;color:var(--green-700);font-weight:700;">Free</td><td style="text-align:center;color:var(--text-muted);font-weight:600;">Free (+ advisory fees)</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section" style="background:var(--green-50);">
  <div class="container" style="max-width:820px;">
    <div class="section-header">
      <span class="section-eyebrow">Why UAE Users Choose FinTrack</span>
      <h2>Built for What Empower Can't See.</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <h3 style="margin-bottom:.5rem;">A dashboard that actually connects</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Empower's net-worth view is only as good as its linked accounts — and it can't link a single UAE bank. FinTrack's PDF upload works with the statement you already have.</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom:.5rem;">No advisor funnel</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Empower's free tier exists to identify prospects for its paid advisory arm. FinTrack's Free plan is the product, not a lead form.</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom:.5rem;">Daily clarity, not quarterly review</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Empower is built for checking net worth occasionally. FinTrack's Safe-to-Spend number is designed to be checked before every purchase.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:720px;">
    <div class="section-header">
      <span class="section-eyebrow">FAQ</span>
      <h2>FinTrack vs Empower — Common Questions</h2>
    </div>
    <div style="border-top:1px solid var(--border);">
      {faqs.map(item => (
        <div class="faq-item">
          <button class="faq-btn">
            {item.q}
            <span class="faq-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--green-700)" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-body">{item.a}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-sm" style="background:var(--green-50);padding-bottom:5rem;">
  <div class="container">
    <div class="cta-band" style="max-width:760px;margin:0 auto;">
      <div style="position:relative;z-index:1;">
        <h2 style="color:#ffffff;font-size:clamp(1.75rem,3.5vw,2.5rem);margin-bottom:1rem;">Track Spending, Not Just Net Worth.</h2>
        <p style="color:rgba(255,255,255,0.55);margin-bottom:2rem;max-width:420px;margin-left:auto;margin-right:auto;">
          Free to start, no advisor calls, and it reads your UAE bank statement in seconds.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
          <a href={SITE.appUrl + '/register'} class="btn-primary" style="background:var(--green-500);color:var(--green-950);">Start Free</a>
          <a href="/compare" class="btn-outline" style="border-color:rgba(255,255,255,0.25);color:rgba(255,255,255,0.75);background:transparent;">See All Comparisons</a>
        </div>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
