---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "FinTrack",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web, iOS, Android",
    "url": "https://fintrack.app",
    "description": "FinTrack is the UAE's leading personal finance app. It scans bank statements via OCR, auto-categorizes every transaction, and shows you a live Safe-to-Spend number — designed for UAE residents, expats, and the GCC.",
    "offers": [
      { "@type": "Offer", "price": "0", "priceCurrency": "USD", "name": "Free Plan" },
      { "@type": "Offer", "price": "9.99", "priceCurrency": "USD", "name": "Premium Plan" }
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "2847"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "FinTrack",
    "url": "https://fintrack.app"
  }
];
---

<BaseLayout
  title="FinTrack — Expense Tracker & Budget App for UAE | Know What You Can Spend Today"
  description="FinTrack is the UAE's smartest personal finance app. Upload your bank statement, get instant AI categorization, and see your Safe-to-Spend number. Supports ADCB, Emirates NBD, FAB, Mashreq & more."
  canonicalPath="/"
  ldJson={ldJson}
>

<!-- ══════════════════════════════════════
     HERO
══════════════════════════════════════ -->
<header class="hero-section">
  <div class="container" style="position:relative;z-index:1;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;">

      <!-- Left copy -->
      <div>
        <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.25);border-radius:100px;padding:6px 16px;margin-bottom:1.75rem;">
          <span style="width:7px;height:7px;border-radius:50%;background:var(--green-400);animation:pulse 2s ease-in-out infinite;display:inline-block;"></span>
          <span style="font-size:.8125rem;font-weight:600;color:var(--green-400);font-family:'Plus Jakarta Sans',sans-serif;">Trusted by 50,000+ UAE residents</span>
        </div>

        <h1 style="color:#ffffff;margin-bottom:1.5rem;">
          Know Exactly What You Can<br>
          <span style="background:linear-gradient(135deg,var(--green-400) 0%,var(--green-500) 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;">Safely Spend Today.</span>
        </h1>

        <p style="color:rgba(255,255,255,0.65);font-size:1.125rem;line-height:1.8;max-width:500px;margin-bottom:2.5rem;">
          FinTrack reads your UAE bank statements, auto-categorizes every dirham, and shows you one clear number — your Safe-to-Spend balance. No spreadsheets. No guesswork.
        </p>

        <div style="display:flex;gap:14px;flex-wrap:wrap;margin-bottom:3rem;">
          <a href={SITE.appUrl + '/register'} class="btn-primary" style="font-size:1.0625rem;padding:1rem 2.25rem;background:var(--green-500);color:var(--green-950);">
            Start Free — No Credit Card
            <svg viewBox="0 0 24 24" fill="none" style="width:18px;height:18px;" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#how-it-works" class="btn-outline" style="border-color:rgba(255,255,255,0.25);color:rgba(255,255,255,0.80);background:rgba(255,255,255,0.05);">
            <svg viewBox="0 0 24 24" fill="none" style="width:16px;height:16px;" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Watch 2-min Demo
          </a>
        </div>

        <!-- Trust stats -->
        <div style="display:inline-flex;flex-wrap:wrap;gap:1.5rem;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.10);border-radius:16px;padding:1.25rem 1.75rem;">
          <div style="text-align:center;">
            <p style="font-size:1.375rem;font-weight:800;color:#ffffff;margin:0;font-family:'Plus Jakarta Sans',sans-serif;">50K+</p>
            <p style="font-size:.75rem;color:rgba(255,255,255,0.45);margin:0;">Active users</p>
          </div>
          <div style="width:1px;background:rgba(255,255,255,0.12);"></div>
          <div style="text-align:center;">
            <p style="font-size:1.375rem;font-weight:800;color:#ffffff;margin:0;font-family:'Plus Jakarta Sans',sans-serif;">12</p>
            <p style="font-size:.75rem;color:rgba(255,255,255,0.45);margin:0;">UAE banks</p>
          </div>
          <div style="width:1px;background:rgba(255,255,255,0.12);"></div>
          <div style="text-align:center;">
            <p style="font-size:1.375rem;font-weight:800;color:#ffffff;margin:0;font-family:'Plus Jakarta Sans',sans-serif;">4.9 ★</p>
            <p style="font-size:.75rem;color:rgba(255,255,255,0.45);margin:0;">User rating</p>
          </div>
        </div>
      </div>

      <!-- Right: App mockup -->
      <div class="hero-mockup-wrap" style="position:relative;display:flex;justify-content:center;">
        <div class="hero-phone-card" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.12);border-radius:28px;padding:1.75rem;max-width:360px;width:100%;box-shadow:0 40px 80px rgba(6,32,16,0.50);">
          <!-- Phone top bar -->
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
            <span style="font-size:.75rem;font-weight:600;color:rgba(255,255,255,0.40);font-family:'Plus Jakarta Sans',sans-serif;">SAFE TO SPEND TODAY</span>
            <span style="font-size:.7rem;color:rgba(16,185,129,0.80);background:rgba(16,185,129,0.12);padding:2px 10px;border-radius:100px;font-weight:600;">● Live</span>
          </div>
          <!-- Big number -->
          <div style="text-align:center;margin-bottom:1.75rem;">
            <p style="font-size:3.5rem;font-weight:800;color:#ffffff;letter-spacing:-0.04em;margin:0;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;">AED 847</p>
            <p style="font-size:.875rem;color:rgba(255,255,255,0.45);margin:.5rem 0 0;">Updated just now</p>
            <div style="margin-top:.875rem;display:inline-flex;align-items:center;gap:6px;background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.20);border-radius:8px;padding:6px 14px;">
              <svg viewBox="0 0 24 24" fill="none" style="width:14px;height:14px;" stroke="var(--green-400)" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span style="font-size:.8125rem;color:var(--green-400);font-weight:600;">You're on track this month</span>
            </div>
          </div>
          <!-- Transactions -->
          <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:16px;padding:1rem;margin-bottom:1rem;">
            <p style="font-size:.6875rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,0.35);margin-bottom:.875rem;font-family:'Plus Jakarta Sans',sans-serif;">Recent Transactions</p>
            <div style="display:flex;flex-direction:column;gap:.75rem;">
              <div style="display:flex;justify-content:space-between;align-items:center;">
                <div style="display:flex;align-items:center;gap:.75rem;">
                  <div style="width:32px;height:32px;border-radius:10px;background:rgba(16,185,129,0.12);display:flex;align-items:center;justify-content:center;">
                    <svg viewBox="0 0 24 24" fill="none" style="width:14px;height:14px;" stroke="var(--green-400)" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                  </div>
                  <div>
                    <p style="font-size:.8125rem;font-weight:600;color:#ffffff;margin:0;">Carrefour</p>
                    <p style="font-size:.7rem;color:rgba(255,255,255,0.35);margin:0;">Groceries</p>
                  </div>
                </div>
                <span style="font-size:.875rem;font-weight:700;color:rgba(255,255,255,0.70);">−AED 143</span>
              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;">
                <div style="display:flex;align-items:center;gap:.75rem;">
                  <div style="width:32px;height:32px;border-radius:10px;background:rgba(245,158,11,0.10);display:flex;align-items:center;justify-content:center;">
                    <svg viewBox="0 0 24 24" fill="none" style="width:14px;height:14px;" stroke="#f59e0b" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                  </div>
                  <div>
                    <p style="font-size:.8125rem;font-weight:600;color:#ffffff;margin:0;">Salary — FAB</p>
                    <p style="font-size:.7rem;color:rgba(255,255,255,0.35);margin:0;">Income</p>
                  </div>
                </div>
                <span style="font-size:.875rem;font-weight:700;color:var(--green-400);">+AED 18,500</span>
              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;">
                <div style="display:flex;align-items:center;gap:.75rem;">
                  <div style="width:32px;height:32px;border-radius:10px;background:rgba(99,102,241,0.10);display:flex;align-items:center;justify-content:center;">
                    <svg viewBox="0 0 24 24" fill="none" style="width:14px;height:14px;" stroke="#818cf8" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                  </div>
                  <div>
                    <p style="font-size:.8125rem;font-weight:600;color:#ffffff;margin:0;">Dewa Bill</p>
                    <p style="font-size:.7rem;color:rgba(255,255,255,0.35);margin:0;">Utilities</p>
                  </div>
                </div>
                <span style="font-size:.875rem;font-weight:700;color:rgba(255,255,255,0.70);">−AED 380</span>
              </div>
            </div>
          </div>
          <!-- Budget bar -->
          <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:16px;padding:1rem;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.625rem;">
              <span style="font-size:.8125rem;font-weight:600;color:rgba(255,255,255,0.60);">Monthly Budget</span>
              <span style="font-size:.8125rem;font-weight:700;color:var(--green-400);">67% remaining</span>
            </div>
            <div style="height:8px;background:rgba(255,255,255,0.08);border-radius:100px;overflow:hidden;">
              <div style="height:100%;width:33%;background:linear-gradient(90deg,var(--green-700),var(--green-400));border-radius:100px;"></div>
            </div>
            <div style="display:flex;justify-content:space-between;margin-top:.5rem;">
              <span style="font-size:.7rem;color:rgba(255,255,255,0.30);">AED 6,220 spent</span>
              <span style="font-size:.7rem;color:rgba(255,255,255,0.30);">AED 18,500 budget</span>
            </div>
          </div>
        </div>

        <!-- Floating badges -->
        <div style="position:absolute;top:-20px;right:-20px;background:var(--surface-card);border:1px solid var(--border);border-radius:14px;padding:.75rem 1rem;box-shadow:var(--shadow-xl);display:flex;align-items:center;gap:.625rem;z-index:2;" class="hero-float-1">
          <div style="width:32px;height:32px;border-radius:8px;background:rgba(16,185,129,0.12);display:flex;align-items:center;justify-content:center;">
            <svg viewBox="0 0 24 24" fill="none" style="width:14px;height:14px;" stroke="var(--green-700)" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>
          <div>
            <p style="font-size:.75rem;font-weight:700;color:var(--text-primary);margin:0;font-family:'Plus Jakarta Sans',sans-serif;">Statement scanned</p>
            <p style="font-size:.6875rem;color:var(--text-muted);margin:0;">217 transactions found</p>
          </div>
        </div>

        <div style="position:absolute;bottom:20px;left:-30px;background:var(--green-800);border-radius:14px;padding:.75rem 1rem;box-shadow:var(--shadow-xl);display:flex;align-items:center;gap:.625rem;z-index:2;" class="hero-float-2">
          <svg viewBox="0 0 24 24" fill="none" style="width:16px;height:16px;flex-shrink:0;" stroke="rgba(255,255,255,0.90)" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span style="font-size:.8125rem;font-weight:700;color:#ffffff;font-family:'Plus Jakarta Sans',sans-serif;">Saved AED 2,340 this month</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Clean arc divider -->
  <div style="position:absolute;bottom:0;left:0;right:0;overflow:hidden;line-height:0;pointer-events:none;">
    <svg viewBox="0 0 1440 72" preserveAspectRatio="none" style="display:block;width:100%;height:72px;" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,72 C360,0 1080,0 1440,72 L1440,72 L0,72 Z" fill="#ffffff"/>
    </svg>
  </div>
</header>

<!-- ══════════════════════════════════════
     BANK LOGOS / SOCIAL PROOF STRIP
══════════════════════════════════════ -->
<div style="background:var(--surface-card);border-bottom:1px solid var(--border);padding:1.5rem 0;">
  <div class="container">
    <p style="text-align:center;font-size:.75rem;text-transform:uppercase;letter-spacing:.10em;color:var(--text-light);font-weight:600;margin-bottom:1.25rem;font-family:'Plus Jakarta Sans',sans-serif;">Supports all major UAE & GCC banks</p>
    <div style="display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:2rem 3rem;opacity:0.55;">
      <span style="font-weight:700;font-size:.9rem;letter-spacing:.02em;color:var(--text-secondary);">Emirates NBD</span>
      <span style="font-weight:700;font-size:.9rem;letter-spacing:.02em;color:var(--text-secondary);">ADCB</span>
      <span style="font-weight:700;font-size:.9rem;letter-spacing:.02em;color:var(--text-secondary);">FAB</span>
      <span style="font-weight:700;font-size:.9rem;letter-spacing:.02em;color:var(--text-secondary);">Mashreq</span>
      <span style="font-weight:700;font-size:.9rem;letter-spacing:.02em;color:var(--text-secondary);">RAKBank</span>
      <span style="font-weight:700;font-size:.9rem;letter-spacing:.02em;color:var(--text-secondary);">DIB</span>
      <span style="font-weight:700;font-size:.9rem;letter-spacing:.02em;color:var(--text-secondary);">HSBC UAE</span>
      <span style="font-weight:700;font-size:.9rem;letter-spacing:.02em;color:var(--text-secondary);">CBD</span>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════
     PROBLEM / WHY FINTRACK
══════════════════════════════════════ -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">The Problem</span>
      <h2>Most Finance Apps Weren't Built for UAE Life.</h2>
      <p>YNAB costs $180/year and doesn't know what a salik charge is. Mint shut down. Copilot doesn't work on Android. And none of them can read your Emirates NBD PDF.</p>
    </div>

    <div class="bento-grid bento-grid-3">
      <div class="card card-interactive">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--green-700)" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <h3>No UAE Bank Support</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Global apps can't connect to Emirates NBD, ADCB, or FAB. You're stuck exporting CSVs and mapping columns manually. Every. Single. Month.</p>
      </div>
      <div class="card card-interactive">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--green-700)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3>Generic Categories, Wrong Context</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Generic apps categorize "SALIK" as miscellaneous and "NOON" as unknown. FinTrack knows UAE merchants, GCC spending patterns, and multi-currency salaries.</p>
      </div>
      <div class="card card-interactive">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--green-700)" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <h3>Complexity Over Clarity</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Zero-based budgeting, envelope systems, 47-category breakdowns. You just want one clear answer: "Can I afford this right now?" FinTrack gives you exactly that.</p>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════
     FEATURES
══════════════════════════════════════ -->
<section id="features" class="section" style="background:var(--green-50);">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">Features</span>
      <h2>Finance that Speaks Your Language.</h2>
      <p>Finally, an app that doesn't feel like a chore. We focus on clarity, not complexity.</p>
    </div>

    <!-- Feature 1: Safe to Spend -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;margin-bottom:6rem;" class="feature-row">
      <div>
        <span class="badge badge-green" style="margin-bottom:1.25rem;">Core Feature</span>
        <h2 style="font-size:clamp(1.75rem,3vw,2.5rem);margin-bottom:1rem;">Safe to Spend Daily</h2>
        <p style="color:var(--text-muted);font-size:1.0625rem;line-height:1.85;margin-bottom:1.75rem;">
          We calculate exactly what you can spend today, after accounting for bills, savings goals, and upcoming expenses. Not your account balance — your <em>safe</em> balance. Updated every time a new transaction lands.
        </p>
        <ul style="display:flex;flex-direction:column;gap:.875rem;list-style:none;padding:0;margin:0;">
          <li style="display:flex;align-items:flex-start;gap:.75rem;">
            <div class="price-check" style="margin-top:3px;"><svg viewBox="0 0 24 24" fill="none" style="width:11px;height:11px;" stroke="var(--green-700)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></div>
            <span style="font-size:.9375rem;color:var(--text-secondary);">Accounts for rent, utilities, and recurring bills automatically</span>
          </li>
          <li style="display:flex;align-items:flex-start;gap:.75rem;">
            <div class="price-check" style="margin-top:3px;"><svg viewBox="0 0 24 24" fill="none" style="width:11px;height:11px;" stroke="var(--green-700)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></div>
            <span style="font-size:.9375rem;color:var(--text-secondary);">Reserves your savings goals before calculating what's free</span>
          </li>
          <li style="display:flex;align-items:flex-start;gap:.75rem;">
            <div class="price-check" style="margin-top:3px;"><svg viewBox="0 0 24 24" fill="none" style="width:11px;height:11px;" stroke="var(--green-700)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></div>
            <span style="font-size:.9375rem;color:var(--text-secondary);">No math required — just open the app and know</span>
          </li>
        </ul>
      </div>
      <div class="feature-visual" style="background:var(--surface-card);border:1px solid var(--border);border-radius:var(--radius-xl);padding:2rem;box-shadow:var(--shadow-lg);">
        <p style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-light);margin-bottom:1.25rem;font-family:'Plus Jakarta Sans',sans-serif;">Safe to Spend — Today</p>
        <div style="text-align:center;padding:1.5rem 0 1.75rem;">
          <p style="font-size:4rem;font-weight:800;color:var(--green-700);letter-spacing:-0.05em;margin:0;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;">AED 847</p>
          <p style="color:var(--text-muted);font-size:.875rem;margin:.5rem 0 0;">as of today, Jun 13</p>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:.75rem;">
          <div style="background:var(--green-50);border:1px solid var(--border-green);border-radius:var(--radius-md);padding:.875rem;text-align:center;">
            <p style="font-size:1.125rem;font-weight:800;color:var(--green-800);margin:0;font-family:'Plus Jakarta Sans',sans-serif;">AED 18.5K</p>
            <p style="font-size:.7rem;color:var(--text-muted);margin:0;">Income</p>
          </div>
          <div style="background:#fff5f5;border:1px solid #fecaca;border-radius:var(--radius-md);padding:.875rem;text-align:center;">
            <p style="font-size:1.125rem;font-weight:800;color:#dc2626;margin:0;font-family:'Plus Jakarta Sans',sans-serif;">AED 6.2K</p>
            <p style="font-size:.7rem;color:var(--text-muted);margin:0;">Spent</p>
          </div>
          <div style="background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);border-radius:var(--radius-md);padding:.875rem;text-align:center;">
            <p style="font-size:1.125rem;font-weight:800;color:#d97706;margin:0;font-family:'Plus Jakarta Sans',sans-serif;">AED 5K</p>
            <p style="font-size:.7rem;color:var(--text-muted);margin:0;">Reserved</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature 2: Statement scanning -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;margin-bottom:6rem;" class="feature-row feature-row-reverse">
      <div class="feature-visual" style="order:1;background:var(--green-950);border-radius:var(--radius-xl);padding:2rem;box-shadow:var(--shadow-xl);">
        <p style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,0.35);margin-bottom:1.25rem;font-family:'Plus Jakarta Sans',sans-serif;">Auto-Import from Statement</p>
