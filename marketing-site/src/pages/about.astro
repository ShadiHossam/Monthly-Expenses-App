---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
---

<BaseLayout
  title="About FinTrack — Born from a Frustration with Financial Complexity"
  description="FinTrack was built by a team tired of finance apps that didn't understand UAE life. Our mission: make personal finance human, accessible, and actually enjoyable."
  canonicalPath="/about"
>

<!-- HERO -->
<div class="page-hero" style="padding-top:9rem;padding-bottom:6rem;">
  <div class="container" style="position:relative;z-index:1;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;text-align:left;" class="about-hero-grid">
      <div>
        <div style="display:inline-block;background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.25);border-radius:6px;padding:4px 12px;margin-bottom:1.25rem;">
          <span style="font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--green-400);font-family:'Plus Jakarta Sans',sans-serif;">Our Story</span>
        </div>
        <h1 style="color:#ffffff;font-size:clamp(2.5rem,5vw,3.75rem);">
          Born from a<br>
          <span style="background:linear-gradient(135deg,var(--green-400),var(--green-500));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;">frustration</span><br>
          with complexity.
        </h1>
        <p style="color:rgba(255,255,255,0.60);font-size:1.0625rem;line-height:1.8;max-width:480px;margin-top:1.25rem;">
          A few years ago, we realized that managing money felt more like a chore than a path to freedom. Complex banking apps, hidden fees, and confusing jargon were the norm. We decided to change that.
        </p>
        <div style="display:flex;gap:2rem;margin-top:2rem;flex-wrap:wrap;">
          <div>
            <p style="font-size:1.5rem;font-weight:800;color:#ffffff;margin:0;font-family:'Plus Jakarta Sans',sans-serif;">2021</p>
            <p style="font-size:.8125rem;color:rgba(255,255,255,0.40);margin:0;">Founded in UAE</p>
          </div>
          <div style="width:1px;background:rgba(255,255,255,0.12);"></div>
          <div>
            <p style="font-size:1.5rem;font-weight:800;color:#ffffff;margin:0;font-family:'Plus Jakarta Sans',sans-serif;">50K+</p>
            <p style="font-size:.8125rem;color:rgba(255,255,255,0.40);margin:0;">Tracking their wealth</p>
          </div>
          <div style="width:1px;background:rgba(255,255,255,0.12);"></div>
          <div>
            <p style="font-size:1.5rem;font-weight:800;color:#ffffff;margin:0;font-family:'Plus Jakarta Sans',sans-serif;">12</p>
            <p style="font-size:.8125rem;color:rgba(255,255,255,0.40);margin:0;">UAE banks supported</p>
          </div>
        </div>
      </div>
      <div>
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.10);border-radius:var(--radius-xl);padding:2rem;">
          <p style="color:rgba(255,255,255,0.55);font-size:1.0625rem;line-height:1.9;font-style:italic;margin-bottom:1.25rem;">
            "We didn't just want to build another finance app. We wanted to build the financial partner that actually rebuilt futures."
          </p>
          <div style="display:flex;align-items:center;gap:.875rem;">
            <div style="width:44px;height:44px;border-radius:50%;background:var(--green-700);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <span style="font-weight:800;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;">SC</span>
            </div>
            <div>
              <p style="font-weight:700;color:#ffffff;margin:0;font-family:'Plus Jakarta Sans',sans-serif;">Sarah Chen</p>
              <p style="font-size:.8125rem;color:rgba(255,255,255,0.40);margin:0;">Co-Founder &amp; CEO</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- MISSION -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">Our Mission</span>
      <h2>We are on a relentless pursuit to make personal finance human, accessible, and actually enjoyable.</h2>
    </div>

    <div class="bento-grid bento-grid-3">
      <div class="card" style="text-align:center;">
        <div style="width:56px;height:56px;border-radius:16px;background:var(--green-50);border:1px solid var(--border-green);display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem;">
          <svg viewBox="0 0 24 24" fill="none" style="width:24px;height:24px;" stroke="var(--green-700)" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
        </div>
        <h3 style="margin-bottom:.75rem;">Empathy First</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">We design every feature by asking how it helps a real person in a real situation — not just how it improves a metric.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div style="width:56px;height:56px;border-radius:16px;background:var(--green-50);border:1px solid var(--border-green);display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem;">
          <svg viewBox="0 0 24 24" fill="none" style="width:24px;height:24px;" stroke="var(--green-700)" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>
        <h3 style="margin-bottom:.75rem;">Radical Clarity</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">No hidden fees. No fine print. Just clear insights and transparent tools that give you back control of your wealth.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div style="width:56px;height:56px;border-radius:16px;background:var(--green-50);border:1px solid var(--border-green);display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem;">
          <svg viewBox="0 0 24 24" fill="none" style="width:24px;height:24px;" stroke="var(--green-700)" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        </div>
        <h3 style="margin-bottom:.75rem;">Shared Growth</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">We only succeed when our users succeed. Our tools are built to help you grow your wealth, one step at a time.</p>
      </div>
    </div>
  </div>
</section>

<!-- TEAM -->
<section class="section" style="background:var(--green-50);">
  <div class="container">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:3rem;flex-wrap:wrap;gap:1rem;">
      <div>
        <span class="section-eyebrow" style="display:block;text-align:left;margin-bottom:.5rem;">The Team</span>
        <h2 style="margin:0;">Meet the Humans Behind the Tech.</h2>
        <p style="color:var(--text-muted);margin:.75rem 0 0;">A diverse collective of designers, engineers, and financial experts dedicated to your success.</p>
      </div>
      <a href="/careers" style="display:inline-flex;align-items:center;gap:6px;font-weight:600;color:var(--green-700);text-decoration:none;font-size:.9375rem;white-space:nowrap;">
        View Open Roles
        <svg viewBox="0 0 24 24" fill="none" style="width:16px;height:16px;" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;" class="team-grid">
      {[
        { name: "Sarah Chen", role: "CEO & Co-Founder", bio: "Former fintech PM at a global bank. Built her first budget spreadsheet at 16 and never stopped obsessing over financial clarity.", init: "SC", color: "var(--green-700)" },
        { name: "Marcus Thorne", role: "CTO", bio: "10 years building financial data systems. Expert in OCR, ML categorization, and making complex data feel simple.", init: "MT", color: "var(--green-600)" },
        { name: "Elena Rodriguez", role: "Head of Product Design", bio: "Obsessed with the intersection of empathy and interface. Every pixel in FinTrack has been thought about 50 times.", init: "ER", color: "var(--green-500)" },
        { name: "Jameson Wu", role: "Chief Economist", bio: "Spent 8 years at a sovereign wealth fund in Abu Dhabi. Understands GCC finance from the inside — guides our UAE-specific intelligence.", init: "JW", color: "var(--green-800)" },
      ].map(member => (
        <div class="card card-interactive">
          <div style={`width:64px;height:64px;border-radius:20px;background:${member.color};display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem;`}>
            <span style="font-size:1.25rem;font-weight:800;color:#ffffff;font-family:'Plus Jakarta Sans',sans-serif;">{member.init}</span>
          </div>
          <h3 style="font-size:1.0625rem;margin-bottom:.25rem;">{member.name}</h3>
          <p style="font-size:.8125rem;font-weight:600;color:var(--green-700);margin-bottom:.875rem;">{member.role}</p>
          <p style="font-size:.875rem;color:var(--text-muted);line-height:1.7;margin:0;">{member.bio}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- VALUES -->
<section class="section">
  <div class="container" style="max-width:820px;">
    <div class="section-header">
      <span class="section-eyebrow">What We Believe</span>
      <h2>Finance shouldn't require a finance degree.</h2>
      <p>We believe financial clarity is a right, not a privilege. Here's what drives every decision we make.</p>
    </div>
    <div style="display:flex;flex-direction:column;gap:1.5rem;">
      {[
        { num: "01", title: "Simplicity over features.", body: "Every feature we don't build is a feature that doesn't confuse you. We ask \"does this help someone feel financially calm?\" — and if the answer isn't yes, we don't ship it." },
        { num: "02", title: "Privacy by design.", body: "Your financial data is yours. We don't sell it, we don't mine it, and we don't share it. Statement data is processed ephemerally and encrypted at rest using AES-256." },
        { num: "03", title: "Built for the UAE, not retrofitted for it.", body: "We didn't take a US app and add AED support. We built from scratch knowing what Salik, DEWA, Talabat, Noon, and an FAB salary deposit look like on a statement." },
        { num: "04", title: "Honest about what we are.", body: "FinTrack is a personal finance tool, not a bank, investment advisor, or broker. We help you understand your money — what you do with that clarity is entirely up to you." },
      ].map(v => (
        <div style="display:flex;gap:2rem;align-items:flex-start;padding:1.75rem;background:var(--surface-card);border:1px solid var(--border);border-radius:var(--radius-xl);">
          <span style="font-size:2rem;font-weight:800;color:var(--border-green);font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:-0.04em;flex-shrink:0;min-width:2.5rem;">{v.num}</span>
          <div>
            <h3 style="font-size:1.125rem;margin-bottom:.5rem;">{v.title}</h3>
            <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.8;margin:0;">{v.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section-sm" style="padding-bottom:5rem;">
  <div class="container">
    <div class="cta-band" style="max-width:760px;margin:0 auto;">
      <div style="position:relative;z-index:1;">
        <h2 style="color:#ffffff;font-size:clamp(1.75rem,3.5vw,2.5rem);margin-bottom:1.25rem;">Ready to Change Your Financial Future?</h2>
        <p style="color:rgba(255,255,255,0.55);margin-bottom:2rem;">Join over 1 million people who are taking back control of their money with FinTrack.</p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
          <a href={SITE.appUrl + '/register'} class="btn-primary" style="background:var(--green-500);color:var(--green-950);">Download the App</a>
          <a href="/careers" class="btn-outline" style="border-color:rgba(255,255,255,0.25);color:rgba(255,255,255,0.75);background:transparent;">View Careers →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 900px) {
    .about-hero-grid { grid-template-columns: 1fr !important; }
    .team-grid { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 500px) {
    .team-grid { grid-template-columns: 1fr !important; }
  }
</style>
