---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";

export function getStaticPaths() {
  const banks = [
    { slug: "rakbank", name: "RAKBank", about: "RAKBank — officially the National Bank of Ras Al Khaimah — was established in 1976 and has built its reputation on SME lending and retail banking rather than large corporate accounts. That retail focus means a high proportion of RAKBank statements are personal current and savings accounts, which is exactly the transaction pattern FinTrack's categorization is tuned for." },
    { slug: "dib", name: "Dubai Islamic Bank (DIB)", about: "Founded in 1975, Dubai Islamic Bank was the world's first full-service Islamic bank. Its statements describe profit distributions and Sharia-compliant finance products rather than conventional interest — when you upload a DIB statement, FinTrack still maps salary deposits, profit payouts, and bill debits to the same clear categories as any conventional account." },
    { slug: "hsbc-uae", name: "HSBC UAE", about: "HSBC has operated in the UAE since the 1940s, tracing back to the British Bank of the Middle East, and today runs as part of the global HSBC Group. Its UAE statements often mix AED transactions with occasional foreign-currency entries — useful context if you're an expat comparing spending across currencies inside FinTrack." },
    { slug: "cbd", name: "Commercial Bank of Dubai (CBD)", about: "Commercial Bank of Dubai was established in 1969 and has grown into a mid-sized UAE bank with a strong retail and SME presence across Dubai. As a bank most commonly used for day-to-day personal and small-business accounts, CBD statements tend to be transaction-dense — a good fit for FinTrack's line-by-line auto-categorization." },
    { slug: "adib", name: "Abu Dhabi Islamic Bank (ADIB)", about: "Abu Dhabi Islamic Bank was founded in 1997 and is now one of the UAE's largest Sharia-compliant banks. Like other Islamic banks, ADIB statements use profit-sharing and Murabaha/Ijara terminology instead of interest — FinTrack still recognizes salary credits, recurring bills, and merchant spending on these statements the same way it would on a conventional account." },
    { slug: "emirates-islamic", name: "Emirates Islamic", about: "Emirates Islamic is the Sharia-compliant banking arm of the Emirates NBD group, offering Islamic versions of standard personal banking products. Because it shares infrastructure with Emirates NBD, its PDF statement layout is broadly similar — FinTrack's OCR handles both formats without extra setup." },
    { slug: "ajman-bank", name: "Ajman Bank", about: "Ajman Bank was established in 2007–2008 as a fully Sharia-compliant bank based in the emirate of Ajman, serving residents across the Northern Emirates. It's a smaller institution than Dubai or Abu Dhabi's major banks, so FinTrack's statement parsing is especially useful for catching every transaction on a shorter monthly history." },
    { slug: "bank-of-sharjah", name: "Bank of Sharjah", about: "Bank of Sharjah was founded in 1973 and is one of the older banks headquartered in the Northern Emirates, with a mix of corporate and retail banking clients. If you're a Bank of Sharjah customer commuting into Dubai or Abu Dhabi for work, FinTrack's Salik and toll-category detection is particularly useful for tracking that cross-emirate commute cost." },
  ];
  return banks.map(bank => ({ params: { slug: bank.slug }, props: { bank } }));
}

const { bank } = Astro.props;

const faqs = [
  { q: `Do I need to share my ${bank.name} login with FinTrack?`, a: `No. You download the PDF statement yourself from the ${bank.name} app or online banking, then upload that file to FinTrack. We never ask for or store your bank credentials.` },
  { q: `How far back can I upload ${bank.name} statements?`, a: `As far back as ${bank.name} makes PDF statements available for download, typically 12+ months through online banking. Free users can upload one statement per month; Premium users get unlimited history.` },
  { q: `Does FinTrack recognize ${bank.name} transaction descriptions?`, a: `Yes. FinTrack's AI is trained on how ${bank.name} formats transaction descriptions, so salary deposits, merchant spending, and recurring debits are categorized correctly from the first upload.` },
];

const ldJson = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Supported Banks", url: "/banks" },
  { name: bank.name, url: `/banks/${bank.slug}` },
];
---

<BaseLayout
  title={`${bank.name} Statement Import & Budgeting | FinTrack`}
  description={`Import your ${bank.name} PDF bank statement into FinTrack for instant AI transaction categorization and a daily Safe-to-Spend number. No bank login sharing.`}
  canonicalPath={`/banks/${bank.slug}`}
  ldJson={ldJson}
  breadcrumbs={breadcrumbs}
>

<div class="page-hero" style="padding-top:9rem;padding-bottom:5rem;">
  <div class="container" style="position:relative;z-index:1;">
    <span class="badge badge-green" style="margin-bottom:1.25rem;background:rgba(16,185,129,0.15);color:var(--green-400);border-color:rgba(16,185,129,0.25);">Statement Import Guide</span>
    <h1 style="color:#ffffff;margin-bottom:1rem;">{bank.name} + FinTrack.</h1>
    <p style="color:rgba(255,255,255,0.55);font-size:1.0625rem;max-width:560px;margin:0 auto;">
      Upload your {bank.name} PDF statement and see every transaction categorized, your salary detected, and your Safe-to-Spend number calculated — in seconds.
    </p>
  </div>
</div>

<section class="section-sm">
  <div class="container" style="max-width:720px;">
    <div class="section-header">
      <span class="section-eyebrow">About {bank.name}</span>
      <h2 style="font-size:1.375rem;">{bank.name} in the UAE.</h2>
    </div>
    <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.8;margin:0;">{bank.about}</p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:820px;">
    <div class="section-header">
      <span class="section-eyebrow">How It Works</span>
      <h2>3 Steps From Statement to Clarity.</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;" class="steps-grid-3">
      <div class="card" style="text-align:center;">
        <span class="step-num">01</span>
        <h3 style="margin-bottom:.5rem;">Download your statement</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Open the {bank.name} app or online banking, go to your account's Statements section, and download a monthly PDF.</p>
      </div>
      <div class="card" style="text-align:center;">
        <span class="step-num">02</span>
        <h3 style="margin-bottom:.5rem;">Upload to FinTrack</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Go to Statements → Upload in FinTrack and drag in the PDF. Our AI extracts every transaction in seconds.</p>
      </div>
      <div class="card" style="text-align:center;">
        <span class="step-num">03</span>
        <h3 style="margin-bottom:.5rem;">See your Safe-to-Spend</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Salary deposits, bills, and merchant spending are auto-categorized, and your daily Safe-to-Spend number updates instantly.</p>
      </div>
    </div>
  </div>
</section>

<section class="section" style="background:var(--green-50);">
  <div class="container" style="max-width:820px;">
    <div class="section-header">
      <span class="section-eyebrow">What FinTrack Detects</span>
      <h2>Built to Understand Your {bank.name} Statement.</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <h3 style="margin-bottom:.5rem;">Salary & income</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Recurring salary deposits are recognized automatically and factored into your Safe-to-Spend calculation.</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom:.5rem;">UAE merchants</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Carrefour, Noon, Talabat, Salik, and DEWA are matched to the right category — not dumped into "miscellaneous."</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom:.5rem;">Recurring bills</h3>
        <p style="color:var(--text-muted);font-size:.9375rem;line-height:1.75;margin:0;">Rent, loan payments, and utility bills are flagged as committed spending so your Safe-to-Spend stays accurate.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:720px;">
    <div class="section-header">
      <span class="section-eyebrow">FAQ</span>
      <h2>{bank.name} Import — Common Questions</h2>
    </div>
    <div style="border-top:1px solid var(--border);">
      {faqs.map(item => (
        <div class="faq-item">
          <button class="faq-btn">
            {item.q}
            <span class="faq-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--green-700)" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-body">{item.a}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-sm" style="background:var(--green-50);padding-bottom:5rem;">
  <div class="container">
    <div class="cta-band" style="max-width:760px;margin:0 auto;">
      <div style="position:relative;z-index:1;">
        <h2 style="color:#ffffff;font-size:clamp(1.75rem,3.5vw,2.5rem);margin-bottom:1rem;">Upload Your {bank.name} Statement.</h2>
        <p style="color:rgba(255,255,255,0.55);margin-bottom:2rem;max-width:420px;margin-left:auto;margin-right:auto;">
          Free to start — see your first Safe-to-Spend number in under 5 minutes.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
          <a href={SITE.appUrl + '/register'} class="btn-primary" style="background:var(--green-500);color:var(--green-950);">Start Free</a>
          <a href="/banks" class="btn-outline" style="border-color:rgba(255,255,255,0.25);color:rgba(255,255,255,0.75);background:transparent;">See All Supported Banks</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 900px) { .steps-grid-3 { grid-template-columns: 1fr !important; } }
</style>

</BaseLayout>
