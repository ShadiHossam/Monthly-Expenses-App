---
import { SITE } from '../config/site';
---

<footer id="site-footer" style="background:var(--green-950);" aria-label="Footer">
  <div class="container py-16">

    <!-- Grid -->
    <div style="display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr 1fr;gap:2rem;margin-bottom:3.5rem;align-items:start;">

      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <div style="width:32px;height:32px;background:var(--green-700);border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg viewBox="0 0 24 24" fill="none" style="width:15px;height:15px;" stroke="#ffffff" stroke-width="2.5"><path d="M3 3v18h18"/><path d="M7 16l4-6 4 4 4-6"/></svg>
          </div>
          <span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:1.0625rem;color:#ffffff;letter-spacing:-0.02em;">{SITE.name}</span>
        </div>
        <p style="color:rgba(255,255,255,0.45);font-size:.9rem;line-height:1.75;max-width:260px;margin-bottom:1.5rem;">
          {SITE.tagline} Built for UAE residents, expats, and the GCC.
        </p>
        <div class="flex gap-3">
          <a href="https://twitter.com/fintrackapp" aria-label="Twitter / X" style="width:36px;height:36px;border-radius:8px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.10);display:flex;align-items:center;justify-content:center;transition:background .2s;text-decoration:none;" onmouseover="this.style.background='rgba(16,185,129,0.15)'" onmouseout="this.style.background='rgba(255,255,255,0.06)'">
            <svg viewBox="0 0 24 24" fill="none" style="width:15px;height:15px;" stroke="rgba(255,255,255,0.55)" stroke-width="2"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
          </a>
          <a href="https://instagram.com/fintrackapp" aria-label="Instagram" style="width:36px;height:36px;border-radius:8px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.10);display:flex;align-items:center;justify-content:center;transition:background .2s;text-decoration:none;" onmouseover="this.style.background='rgba(16,185,129,0.15)'" onmouseout="this.style.background='rgba(255,255,255,0.06)'">
            <svg viewBox="0 0 24 24" fill="none" style="width:15px;height:15px;" stroke="rgba(255,255,255,0.55)" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        </div>
      </div>

      <!-- Product -->
      <div style="text-align:left;">
        <h4 style="color:#ffffff;font-weight:700;font-size:.75rem;text-transform:uppercase;letter-spacing:.10em;margin-bottom:1.25rem;font-family:'Plus Jakarta Sans',sans-serif;">Product</h4>
        <ul class="space-y-3" style="list-style:none;padding:0;margin:0;">
          <li><a href="/#features" class="footer-link">Features</a></li>
          <li><a href="/pricing"   class="footer-link">Pricing</a></li>
          <li><a href={SITE.appUrl} class="footer-link">Web App</a></li>
          <li><a href="/#how-it-works" class="footer-link">How It Works</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div style="text-align:left;">
        <h4 style="color:#ffffff;font-weight:700;font-size:.75rem;text-transform:uppercase;letter-spacing:.10em;margin-bottom:1.25rem;font-family:'Plus Jakarta Sans',sans-serif;">Company</h4>
        <ul class="space-y-3" style="list-style:none;padding:0;margin:0;">
          <li><a href="/about"    class="footer-link">About</a></li>
          <li><a href="/careers" class="footer-link">Careers</a></li>
          <li><a href="/faq"     class="footer-link">FAQ</a></li>
          <li><a href="/contact" class="footer-link">Contact</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div style="text-align:left;">
        <h4 style="color:#ffffff;font-weight:700;font-size:.75rem;text-transform:uppercase;letter-spacing:.10em;margin-bottom:1.25rem;font-family:'Plus Jakarta Sans',sans-serif;">Resources</h4>
        <ul class="space-y-3" style="list-style:none;padding:0;margin:0;">
          <li><a href="/blog"     class="footer-link">Blog</a></li>
          <li><a href="/banks"    class="footer-link">Supported Banks</a></li>
          <li><a href="/compare"  class="footer-link">Compare</a></li>
          <li><a href="/security" class="footer-link">Security</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div style="text-align:left;">
        <h4 style="color:#ffffff;font-weight:700;font-size:.75rem;text-transform:uppercase;letter-spacing:.10em;margin-bottom:1.25rem;font-family:'Plus Jakarta Sans',sans-serif;">Legal</h4>
        <ul class="space-y-3" style="list-style:none;padding:0;margin:0;">
          <li><a href="/privacy" class="footer-link">Privacy Policy</a></li>
          <li><a href="/terms"   class="footer-link">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div style="border-top:1px solid rgba(255,255,255,0.10);padding-top:2rem;">
      <p style="color:rgba(255,255,255,0.35);font-size:.875rem;">
        © <span id="copyright-year"></span> {SITE.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    color: rgba(255,255,255,0.45); font-size: .9rem; text-decoration: none;
    transition: color .2s; display: block;
  }
  .footer-link:hover { color: rgba(255,255,255,0.85); }
  @media (max-width: 768px) {
    #site-footer .container > div:first-of-type {
      grid-template-columns: 1fr 1fr !important;
    }
  }
  @media (max-width: 500px) {
    #site-footer .container > div:first-of-type {
      grid-template-columns: 1fr !important;
    }
  }
</style>
